<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="track_costs_revenues" position="after">
                <setting
                    id="tms_vehicles_analytic_plan"
                    help="Plan whose accounts represent the vehicles in their analytic distribution"
                    invisible="not group_analytic_accounting"
                >
                    <field name="tms_vehicles_analytic_plan_id" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
